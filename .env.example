# 4labscloud - Beispiel-Konfiguration
# Kopiere nach .env und passe Werte an. .env NIEMALS committen.

# Datenbank
POSTGRES_USER=4labs
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=4labscloud
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=change-me-redis-password
REDIS_HOST=redis
REDIS_PORT=6379

# Service-Token (Go <-> Rust)
# Generieren mit: openssl rand -hex 32
SERVICE_TOKEN=change-me-32-byte-hex

# Storage-Verschluesselung (AES-256-GCM)
# Generieren mit: openssl rand -base64 32
STORAGE_KEY=change-me-base64-32-bytes

# MFA-Secret-Verschluesselung (AES-256-GCM)
# Generieren mit: openssl rand -base64 32
MFA_KEY=change-me-base64-32-bytes

# JWT
# Generieren mit: openssl rand -hex 32
JWT_SECRET=change-me-32-byte-hex
JWT_TTL_MINUTES=15

# Ports (intern)
APP_PORT=8080
UPLOAD_PORT=8081

# Audit-Log Pseudonymisierung (HMAC-SHA256) & Retention
AUDIT_HMAC_KEY=change-me-base64-32-bytes
AUDIT_RETENTION_DAYS=90

# Speicherplatz Quota (Default in GB fuer neue/ungesetzte Nutzer)
DEFAULT_QUOTA_GB=50
