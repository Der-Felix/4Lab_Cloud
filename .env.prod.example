# ==============================================================================
# 4labscloud - Produktions-Umgebungsvariablen (.env.prod.example)
# ==============================================================================
# Kopiere diese Datei nach .env im Hauptverzeichnis oder nutze sie gezielt:
#   cp .env.prod.example .env
#
# SICHERHEITSHINWEIS:
# - Die Datei .env darf NIEMALS in die Versionskontrolle eingecheckt werden!
# - Alle Passwoerter und Schluessel MUESSEN vor dem Start neu generiert werden.
# - Mindestlaenge fuer Passwoerter: 32 Zeichen (kryptografisch zufaellig).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Domaenen-Konfiguration (fuer Nginx & TLS Zertifikate)
# ------------------------------------------------------------------------------
# Echte Domain eintragen, unter der die Cloud erreichbar ist.
# Die Let's-Encrypt-Zertifikate muessen unter /etc/letsencrypt/live/<DOMAIN>/ liegen.
DOMAIN=cloud.example.com

# ------------------------------------------------------------------------------
# 2. PostgreSQL Datenbank
# ------------------------------------------------------------------------------
# Eigener Datenbankbenutzer und starkes Passwort fuer die PostgreSQL-Instanz.
POSTGRES_USER=cloud_prod_user
# Generieren: openssl rand -hex 24
POSTGRES_PASSWORD=GENERATE_STRONG_RANDOM_POSTGRES_PASSWORD_HERE
POSTGRES_DB=4labscloud_prod
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. Redis Cache & Sessions
# ------------------------------------------------------------------------------
# Starkes Passwort fuer Redis AUTH.
# Generieren: openssl rand -hex 24
REDIS_PASSWORD=GENERATE_STRONG_RANDOM_REDIS_PASSWORD_HERE
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. Service-zu-Service Authentifizierung (Go App-Server <-> Rust Upload-Service)
# ------------------------------------------------------------------------------
# Shared Secret fuer interne REST-Aufrufe (Authorization: Bearer <TOKEN>).
# Generieren mit: openssl rand -hex 32
SERVICE_TOKEN=GENERATE_32_BYTE_HEX_SERVICE_TOKEN_HERE

# ------------------------------------------------------------------------------
# 5. Kryptografie-Schluessel (AES-256-GCM)
# ------------------------------------------------------------------------------
# Master-Key zur transparenten Verschluesselung aller Dateien auf Festplatte (at-rest).
# ACHTUNG: Geht dieser Key verloren, sind ALLE gespeicherten Dateien unlesbar!
# Generieren mit: openssl rand -base64 32
STORAGE_KEY=GENERATE_32_BYTE_BASE64_STORAGE_KEY_HERE

# Key zur Verschluesselung der TOTP-Secrets in der Datenbank (MFA-Schutz).
# Generieren mit: openssl rand -base64 32
MFA_KEY=GENERATE_32_BYTE_BASE64_MFA_KEY_HERE

# ------------------------------------------------------------------------------
# 6. Session & JWT Authentifizierung
# ------------------------------------------------------------------------------
# Signaturschluessel fuer JWT-Tokens der Weboberflaeche.
# Generieren mit: openssl rand -hex 32
JWT_SECRET=GENERATE_32_BYTE_HEX_JWT_SECRET_HERE

# Gueltigkeitsdauer von Access-Tokens in Minuten (BSI-Empfehlung: 15 Minuten).
JWT_TTL_MINUTES=15

# ------------------------------------------------------------------------------
# 7. DSGVO & Compliance
# ------------------------------------------------------------------------------
# HMAC-Schluessel zur Einweg-Pseudonymisierung von User-IDs in Audit-Logs (Art. 5/32).
# Generieren mit: openssl rand -base64 32
AUDIT_HMAC_KEY=GENERATE_32_BYTE_BASE64_AUDIT_HMAC_KEY_HERE

# Aufbewahrungsfrist fuer Audit-Logs in Tagen gemaess Datenschutz-Konzept.
AUDIT_RETENTION_DAYS=90

# ------------------------------------------------------------------------------
# 8. Quota & Limits
# ------------------------------------------------------------------------------
# Standard-Speicherplatzlimit pro Benutzer in Gigabyte.
DEFAULT_QUOTA_GB=50

# ------------------------------------------------------------------------------
# 9. Interne Ports (Container-intern)
# ------------------------------------------------------------------------------
APP_PORT=8080
UPLOAD_PORT=8081
